<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.notes">

    <permission android:name="com.example.notes.permission.READ" android:protectionLevel="signature" />
    <permission android:name="com.example.notes.permission.WRITE" android:protectionLevel="signature" />

    <application android:label="Notes">
        <!-- Exported without any permission (AndroGoat / Goatlin pattern). -->
        <provider android:name=".NotesProvider" android:authorities="com.example.notes.notes" android:enabled="true" android:exported="true" /> <!-- $ Alert -->
        <provider android:name="com.example.notes.AccountProvider" android:authorities="com.example.notes.accounts" android:exported="true"></provider> <!-- $ Alert -->

        <!-- Safe: not exported. -->
        <provider android:name=".PrivateProvider" android:authorities="com.example.notes.private" android:exported="false" />
        <!-- Safe: no exported attribute, so not exported for targetSdkVersion 17 and above. -->
        <provider android:name=".DefaultProvider" android:authorities="com.example.notes.default" />
        <!-- Safe: protected by a single permission. -->
        <provider android:name=".FullPermissionProvider" android:authorities="com.example.notes.full" android:exported="true" android:permission="com.example.notes.permission.READ" />
        <!-- Safe: protected by both read and write permissions. -->
        <provider android:name=".ReadWriteProvider" android:authorities="com.example.notes.rw" android:exported="true" android:readPermission="com.example.notes.permission.READ" android:writePermission="com.example.notes.permission.WRITE" />
        <!-- Not reported here: incomplete permissions are reported by java/android/incomplete-provider-permissions. -->
        <provider android:name=".ReadOnlyProvider" android:authorities="com.example.notes.ro" android:exported="true" android:readPermission="com.example.notes.permission.READ" />
        <!-- Safe: protected with path permissions. -->
        <provider android:name=".PathProvider" android:authorities="com.example.notes.path" android:exported="true">
            <path-permission android:pathPrefix="/" android:permission="com.example.notes.permission.READ" />
        </provider>
    </application>
</manifest>
