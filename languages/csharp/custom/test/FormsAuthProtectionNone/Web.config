<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login" protection="None" timeout="30" /> <!-- $ Alert -->
    </authentication>
  </system.web>
  <location path="Admin">
    <system.web>
      <authentication mode="Forms">
        <forms name=".ADMINAUTH" protection=" none " /> <!-- $ Alert -->
      </authentication>
    </system.web>
  </location>
</configuration>
