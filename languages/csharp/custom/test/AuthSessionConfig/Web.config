<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- BAD: ViewState MAC disabled and encryption disabled -->
    <pages enableViewStateMac="false" viewStateEncryptionMode="Never" />
    <!-- GOOD: ASP.NET rejects invalid timeout values -->
    <sessionState mode="InProc" timeout="-1" />
    <authentication mode="Forms">
      <!-- BAD: forms ticket lasts 30 days -->
      <forms loginUrl="~/Login.aspx" timeout="43200" requireSSL="true" />
    </authentication>
    <membership defaultProvider="Weak">
      <providers>
        <!-- BAD: minimum password length 6 -->
        <add name="Weak" type="System.Web.Security.SqlMembershipProvider" minRequiredPasswordLength="6" minRequiredNonalphanumericCharacters="0" />
        <!-- GOOD: minimum password length 12 -->
        <add name="Strong" type="System.Web.Security.SqlMembershipProvider" minRequiredPasswordLength="12" minRequiredNonalphanumericCharacters="1" />
      </providers>
    </membership>
  </system.web>
  <location path="secure">
    <system.web>
      <!-- GOOD: secure defaults -->
      <pages enableViewStateMac="true" viewStateEncryptionMode="Always" />
      <sessionState mode="InProc" timeout="20" />
    </system.web>
  </location>
</configuration>
